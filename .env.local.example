# Variables de entorno para MA-IN
# Copia este archivo como .env.local y configura los valores

# Google Maps API Key (requerido para el mapa de ubicación)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_api_key_de_google_maps

# URL base de la API (para futuras integraciones)
NEXT_PUBLIC_API_URL=https://api.ma-in.mx

# Email de contacto
NEXT_PUBLIC_CONTACT_EMAIL=contacto@ma-in.mx

# Teléfono de contacto
NEXT_PUBLIC_CONTACT_PHONE=+52 1 777 304 5114

# Resend — envío de correos transaccionales
# Obtén tu API key en resend.com/api-keys
# Requiere dominio ma-in.mx verificado en resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Cron secret — protege /api/cron/stagnant de llamadas no autorizadas
# Vercel lo inyecta automáticamente; en local usa cualquier string para pruebas
CRON_SECRET=un-secreto-seguro-aqui
